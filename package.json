{
  "name": "myjira",
  "version": "1.0.0",
  "description": "Portable task list and Eisenhower matrix desktop application",
  "main": "src/main/main.js",
  "private": true,
  "author": {
    "name": "Hélder RL",
    "email": "helder0xff@gmail.com"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "start:linux": "electron --no-sandbox .",
    "test": "node --test test/unit/taskSchema.test.js test/unit/taskStore.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/electron.test.js",
    "test:all": "npm test && npm run test:e2e",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pack:linux": "electron-builder --linux dir",
    "pack:win": "electron-builder --win dir",
    "dist:linux": "npm run clean && electron-builder --linux AppImage",
    "dist:win": "npm run clean && electron-builder --win portable",
    "dist": "npm run clean && electron-builder --linux AppImage --win portable"
  },
  "build": {
    "appId": "app.myjira.desktop",
    "productName": "myJira",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "appImage": {
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1"
  },
  "desktopName": "myJira"
}
